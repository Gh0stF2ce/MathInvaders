@{
    ViewData["Title"] = "Math Invaders - Главная";
}
<!DOCTYPE html>
<html>
<head>
    <title>Math Invaders</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .auth-buttons {
            margin-right: 20px;
        }

            .auth-buttons a {
                margin-left: 10px;
                text-decoration: none;
                padding: 5px 10px;
                border: 1px solid #e94560;
                border-radius: 5px;
                color: #e94560;
            }

                .auth-buttons a:hover {
                    background-color: #e94560;
                    color: white;
                }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Math Invaders</h1>
            <div class="auth-buttons">
                @if (User.Identity.IsAuthenticated)
                {
                    <span>Привет, @User.Identity.Name!</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                        <button type="submit" style="margin-left: 10px;">Выйти</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Вход</a>
                    <a asp-controller="Account" asp-action="Register">Регистрация</a>
                }
            </div>
        </div>
        <p>Добро пожаловать в математическую игру на захват территорий!</p>
        <form asp-controller="Game" asp-action="StartGame" method="post">
            <label for="classLevel">Выберите класс:</label>
            <select name="classLevel" id="classLevel">
                <option value="5">5 класс</option>
                <option value="6">6 класс</option>
                <option value="7">7 класс</option>
            </select>
            <input type="submit" value="Начать игру" />
        </form>
    </div>
</body>
</html>