@model MathInvaders.Models.GameState
@{
    ViewData["Title"] = "Math Invaders";
}
<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        /* Запрещаем выделение текста в модальном окне */
        .modal-content {
            user-select: none; /* Отключаем выделение текста */
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Захватчики</h1>
        @if (Model.GameOver)
        {
            <h2>@Model.Winner</h2>
            <h3>Таблица лидеров</h3>
            <table class="leaderboard">
                <thead>
                    <tr>
                        <th>Игрок</th>
                        <th>Захвачено клеток</th>
                        <th>Остаток монет</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.Players.OrderByDescending(p => p.CapturedCells))
                    {
                        <tr>
                            <td>@player.Name</td>
                            <td>@player.CapturedCells</td>
                            <td>@player.Coins</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h3>Текущий игрок: @Model.Players[Model.CurrentPlayerIndex].Name</h3>
        }
        @if (TempData["Message"] != null)
        {
            <p class="message">@TempData["Message"]</p>
        }
        <p>Active Player ID (для отладки): @Model.ActivePlayerId</p>
        <table class="game-table" id="gameField">
            @for (int y = 0; y < Model.Grid.GetLength(1); y++)
            {
                <tr>
                    @for (int x = 0; x < Model.Grid.GetLength(0); x++)
                    {
                        var cell = Model.Grid[x, y];
                        var isHighlighted = Model.LastMovedCell.HasValue && Model.LastMovedCell.Value.X == x && Model.LastMovedCell.Value.Y == y;
                        var currentPlayer = Model.Players.FirstOrDefault(p => p.Id == Model.ActivePlayerId);
                        var isCurrentPlayerCell = currentPlayer != null && currentPlayer.X == x && currentPlayer.Y == y;
                        var isAvailable = !isCurrentPlayerCell && currentPlayer != null && Math.Abs(currentPlayer.X - x) + Math.Abs(currentPlayer.Y - y) == 1;
                        <td class="@(isHighlighted ? "highlight" : "") @(isCurrentPlayerCell ? "current-player-cell" : "") @(isAvailable ? "available" : "")" data-x="@x" data-y="@y">
                            @if (cell.OwnerId.HasValue)
                            {
                                <span>Игрок @(cell.OwnerId)</span>
                            }
                            else if (!cell.IsRevealed)
                            {
                                <span>Сложность: @cell.Difficulty<br />Стоимость: @cell.Cost</span>
                            }
                            else
                            {
                                <span>@cell.Task</span>
                            }
                            @foreach (var player in Model.Players)
                            {
                                if (player.X == x && player.Y == y)
                                {
                                    <span class="player">@player.Name</span>
                                }
                            }
                        </td>
                    }
                </tr>
            }
        </table>
        <div>
            <h3>Игроки:</h3>
            <ul class="players-list">
                @foreach (var player in Model.Players)
                {
                    var isCurrent = player.Id == Model.ActivePlayerId;
                    <li class="@(isCurrent ? "current-player" : "")">
                        @player.Name: Монеты = @player.Coins, Клетки = @player.CapturedCells (X: @player.X, Y: @player.Y)
                    </li>
                }
            </ul>
        </div>
        <form asp-action="Reset" method="post">
            <input type="submit" value="Новая игра" />
        </form>
    </div>

    <!-- Модальное окно для траты монет -->
    <div id="spendCoinsModal" class="modal">
        <div class="modal-content">
            <h3>Тратить монеты?</h3>
            <p>Стоимость: <span id="coinCost"></span> монет</p>
            <button id="spendYes">Да</button>
            <button id="spendNo">Нет</button>
        </div>
    </div>

    <!-- Модальное окно для захвата чужой клетки -->
    <div id="captureModal" class="modal">
        <div class="modal-content">
            <h3>Захватить клетку?</h3>
            <p>Вариант 1: Решить ту же задачу за <span id="doubleCost"></span> монет</p>
            <p>Вариант 2: Решить более сложную задачу за <span id="originalCost"></span> монет</p>
            <button id="captureOriginal">Вариант 1</button>
            <button id="captureNew">Вариант 2</button>
            <button id="captureCancel">Отмена</button>
        </div>
    </div>

    <!-- Модальное окно для ввода ответа -->
    <div id="answerModal" class="modal">
        <div class="modal-content">
            <h3>Введите ответ</h3>
            <p>Задача: <span id="taskText"></span></p>
            <p>Осталось времени: <span id="timer">15</span> сек</p>
            <input type="number" id="answerInput" required />
            <button id="submitAnswer">Ответить</button>
        </div>
    </div>

    <script>
        const gameField = document.getElementById('gameField');
        const spendCoinsModal = document.getElementById('spendCoinsModal');
        const captureModal = document.getElementById('captureModal');
        const answerModal = document.getElementById('answerModal');
        const spendYes = document.getElementById('spendYes');
        const spendNo = document.getElementById('spendNo');
        const coinCost = document.getElementById('coinCost');
        const doubleCost = document.getElementById('doubleCost');
        const originalCost = document.getElementById('originalCost');
        const captureOriginal = document.getElementById('captureOriginal');
        const captureNew = document.getElementById('captureNew');
        const captureCancel = document.getElementById('captureCancel');
        const taskText = document.getElementById('taskText');
        const answerInput = document.getElementById('answerInput');
        const submitAnswer = document.getElementById('submitAnswer');
        const timerDisplay = document.getElementById('timer');
        const currentPlayerId = @Model.ActivePlayerId;
        let timeLeft = 15; // Уменьшаем таймер до 15 секунд
        let timerInterval = null;

        // Отключаем контекстное меню в модальном окне
        answerModal.addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        gameField.addEventListener('click', function(e) {
            const td = e.target.closest('td');
            if (!td || !td.classList.contains('available')) return;

            const x = parseInt(td.getAttribute('data-x'));
            const y = parseInt(td.getAttribute('data-y'));

            fetch('/Game/Move', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playerId: currentPlayerId, direction: getDirection(x, y) })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.isOccupied) {
                        doubleCost.textContent = data.doubleCost;
                        originalCost.textContent = data.originalCost;
                        captureModal.style.display = 'flex';
                    } else {
                        coinCost.textContent = data.cost;
                        spendCoinsModal.style.display = 'flex';
                    }
                } else {
                    alert(data.message || 'Нельзя туда пойти!');
                }
            })
            .catch(error => alert('Произошла ошибка при перемещении: ' + error.message));
        });

        function getDirection(x, y) {
            const currentX = @Model.Players.First(p => p.Id == Model.ActivePlayerId).X;
            const currentY = @Model.Players.First(p => p.Id == Model.ActivePlayerId).Y;
            if (x === currentX - 1 && y === currentY) return 'left';
            if (x === currentX + 1 && y === currentY) return 'right';
            if (y === currentY - 1 && x === currentX) return 'up';
            if (y === currentY + 1 && x === currentX) return 'down';
            return '';
        }

        spendYes.addEventListener('click', function() { spendCoins(true); });
        spendNo.addEventListener('click', function() { spendCoins(false); });

        function spendCoins(spend) {
            fetch('/Game/SpendCoins', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playerId: currentPlayerId, spend: spend })
            })
            .then(response => response.json())
            .then(data => {
                spendCoinsModal.style.display = 'none';
                if (data.success && spend) {
                    taskText.textContent = data.task;
                    timeLeft = 15; // Устанавливаем новый таймер
                    timerDisplay.textContent = timeLeft;
                    answerModal.style.display = 'flex';
                    startTimer();
                } else if (!data.success) {
                    alert(data.message || 'Ошибка!');
                    window.location.reload();
                } else {
                    window.location.reload();
                }
            })
            .catch(error => alert('Произошла ошибка при обработке монет!'));
        }

        captureOriginal.addEventListener('click', function() { captureCell(true); });
        captureNew.addEventListener('click', function() { captureCell(false); });
        captureCancel.addEventListener('click', function() {
            captureModal.style.display = 'none';
            window.location.reload();
        });

        function captureCell(useOriginalTask) {
            fetch('/Game/CaptureCell', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playerId: currentPlayerId, useOriginalTask: useOriginalTask })
            })
            .then(response => response.json())
            .then(data => {
                captureModal.style.display = 'none';
                if (data.success) {
                    taskText.textContent = data.task;
                    timeLeft = 15; // Новый таймер для захвата
                    timerDisplay.textContent = timeLeft;
                    answerModal.style.display = 'flex';
                    startTimer();
                } else {
                    alert(data.message || 'Ошибка при захвате!');
                    window.location.reload();
                }
            })
            .catch(error => alert('Произошла ошибка при захвате клетки!'));
        }

        submitAnswer.addEventListener('click', function() {
            const answer = parseInt(answerInput.value);
            if (isNaN(answer)) {
                alert('Введите число!');
                return;
            }
            clearInterval(timerInterval);
            fetch('/Game/SubmitAnswer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playerId: currentPlayerId, answer: answer })
            })
            .then(response => response.json())
            .then(data => {
                answerModal.style.display = 'none';
                if (data.success && !data.wasCorrect) {
                    alert('Неверный ответ! Вы вернулись на предыдущую клетку, монеты сохранены, задача обновлена.');
                }
                window.location.reload();
            })
            .catch(error => alert('Произошла ошибка при отправке ответа!'));
        });

        function startTimer() {
            timerInterval = setInterval(() => {
                timeLeft--;
                timerDisplay.textContent = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    answerModal.style.display = 'none';
                    fetch('/Game/Timeout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ playerId: currentPlayerId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message + ' Вы вернулись на предыдущую клетку, монеты сохранены, задача обновлена.');
                            window.location.reload();
                        }
                    })
                    .catch(error => alert('Ошибка при обработке таймаута!'));
                }
            }, 1000);
        }
    </script>
</body>
</html>